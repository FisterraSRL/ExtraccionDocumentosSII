# Copiar a .env y completar con datos reales. .env nunca se commitea.

# ---- SII ----
SII_RUT=76xxxxxx-x
# Ruta al archivo .pfx, fuera del repo (ej: secrets/certificado.pfx)
SII_CERT_PATH=secrets/certificado.pfx
SII_CERT_PASSWORD=

# ---- Finnegans ----
FINNEGANS_API_URL=
FINNEGANS_API_KEY=
# Completar según el tipo de autenticación real que use la API (API key / OAuth / usuario-clave)
FINNEGANS_ENV=sandbox

# ---- App ----
DATABASE_URL=sqlite:///./sii_finnegans.db
