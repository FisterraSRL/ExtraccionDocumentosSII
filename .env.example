# Copiar a .env y completar con datos reales. .env nunca se commitea.

# ---- Acceso al portal ----
# Sin esto el portal se niega a abrirse, en vez de quedar sin protección.
PORTAL_USUARIO=
PORTAL_PASSWORD=
# Firma la cookie de sesión. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Solo en desarrollo sobre http://localhost, para que la cookie viaje sin TLS.
# En producción NO definir esta variable.
PORTAL_COOKIE_INSEGURA=1
# Entrar sin pasar por el login. Para desarrollo: volver a autenticarse cada 12 horas
# no protege de nada cuando el portal escucha en la propia máquina.
# Solo tiene efecto si el pedido llega desde loopback (127.0.0.1 / ::1) y no estamos
# en el despliegue serverless, así que dejarla activada por error no abre el portal
# publicado. Aun así, en producción NO definirla.
PORTAL_SIN_LOGIN=0

# ---- SII (solo en la máquina que sincroniza) ----
SII_RUT=76xxxxxx-x
# Ruta al archivo .pfx, fuera del repo (ej: secrets/certificado.pfx)
SII_CERT_PATH=secrets/certificado.pfx
SII_CERT_PASSWORD=

# ---- Finnegans (Teamplace) ----
FINNEGANS_API_URL=https://api.finneg.com/api
# Client_ID y Client_Secret se configuran por certificado en /configuracion.
FINNEGANS_MATCH_UMBRAL=0.86
FINNEGANS_ENV=sandbox
# Circuito de compras con el que se registra el comprobante.
# Ver los activos en /WorkflowEntidadAPI/list (ej: CENTRALIZA, COMPRHAC, TESOCPRACONT).
FINNEGANS_WORKFLOW=
# Producto del maestro con el que se cargan las líneas. Los ítems del SII son texto
# libre del emisor y no tienen código propio. Ver /producto/list (ej: GTOSGRAL).
FINNEGANS_PRODUCTO=
# Producto de descuento global con tasa 19 % y tag DESCUENTO en Finnegans.
FINNEGANS_PRODUCTO_DESCUENTO_AFECTO=
# Producto de descuento exento para documentos sin IVA. Obligatorio solo si aparece
# un descuento exento; debe existir y tener la imputación correcta en Finnegans.
FINNEGANS_PRODUCTO_DESCUENTO_EXENTO=
# Gastos Comunes: compensa cargos públicos y ajustes excluidos de la base SII.
FINNEGANS_PRODUCTO_AJUSTE_EXENTO=AACZ-2048
# Temporalmente inactivo: durante las pruebas todas las líneas del JSON usan
# DIMCTC, centro 5 al 100 %, incluso si hay una distribución manual guardada.
# Si la cuenta de compra exige DIMBU, se agrega el bien EPRUEB-001 al 100 %.
FINNEGANS_CENTRO_COSTO_PREDETERMINADO=5
# Durante las pruebas, el JSON usa siempre EmpresaCodigo PRUEBA39.
# Las credenciales de API siguen siendo las del certificado activo.
# PES y no CLP: la instancia usa PES como moneda local. Ver /moneda/list.
FINNEGANS_MONEDA=PES
# Ver /condicionPago/list (Contado, 30D, 60D, ...).
FINNEGANS_CONDICION_PAGO=30D
# Conceptos del desglose impositivo.
FINNEGANS_CONCEPTO_IVA=COMPRA_IVA_19
FINNEGANS_CONCEPTO_EXENTO=ivacomexe

# Cuándo se guarda el PDF de cada documento (pesa ~170 KB y no comprime):
#   demanda        = no se baja al sincronizar; se trae al abrirlo y queda guardado
#   sincronizacion = se bajan todos al sincronizar (obligatorio en serverless)
#   nunca          = se trae al abrirlo y no se guarda
PDF_MODO=demanda

# ---- Base de datos ----
# Desarrollo local:
DATABASE_URL=sqlite:///./sii_finnegans.db
# En la nube, el Postgres alojado (Neon, Supabase, Vercel Postgres).
# Se acepta tal cual lo entrega el proveedor: postgres://... o postgresql://...
# DATABASE_URL=postgresql://usuario:clave@host/base
